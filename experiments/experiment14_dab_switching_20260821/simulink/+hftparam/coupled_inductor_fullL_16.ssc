component coupled_inductor_fullL_16
% Full 16x16 reciprocal coupled winding component.
% Constitutive law: v = R.*i + L*i.der

nodes
    p1 = foundation.electrical.electrical;
    n1 = foundation.electrical.electrical;
    p2 = foundation.electrical.electrical;
    n2 = foundation.electrical.electrical;
    p3 = foundation.electrical.electrical;
    n3 = foundation.electrical.electrical;
    p4 = foundation.electrical.electrical;
    n4 = foundation.electrical.electrical;
    p5 = foundation.electrical.electrical;
    n5 = foundation.electrical.electrical;
    p6 = foundation.electrical.electrical;
    n6 = foundation.electrical.electrical;
    p7 = foundation.electrical.electrical;
    n7 = foundation.electrical.electrical;
    p8 = foundation.electrical.electrical;
    n8 = foundation.electrical.electrical;
    p9 = foundation.electrical.electrical;
    n9 = foundation.electrical.electrical;
    p10 = foundation.electrical.electrical;
    n10 = foundation.electrical.electrical;
    p11 = foundation.electrical.electrical;
    n11 = foundation.electrical.electrical;
    p12 = foundation.electrical.electrical;
    n12 = foundation.electrical.electrical;
    p13 = foundation.electrical.electrical;
    n13 = foundation.electrical.electrical;
    p14 = foundation.electrical.electrical;
    n14 = foundation.electrical.electrical;
    p15 = foundation.electrical.electrical;
    n15 = foundation.electrical.electrical;
    p16 = foundation.electrical.electrical;
    n16 = foundation.electrical.electrical;
end

parameters
    R = { ones(16,1), 'Ohm' };
    L = { eye(16), 'H' };
end

variables
    i = { zeros(16,1), 'A' };
    v = { zeros(16,1), 'V' };
end

branches
    i(1) : p1.i -> n1.i;
    i(2) : p2.i -> n2.i;
    i(3) : p3.i -> n3.i;
    i(4) : p4.i -> n4.i;
    i(5) : p5.i -> n5.i;
    i(6) : p6.i -> n6.i;
    i(7) : p7.i -> n7.i;
    i(8) : p8.i -> n8.i;
    i(9) : p9.i -> n9.i;
    i(10) : p10.i -> n10.i;
    i(11) : p11.i -> n11.i;
    i(12) : p12.i -> n12.i;
    i(13) : p13.i -> n13.i;
    i(14) : p14.i -> n14.i;
    i(15) : p15.i -> n15.i;
    i(16) : p16.i -> n16.i;
end

equations
    v == [ p1.v-n1.v; p2.v-n2.v; p3.v-n3.v; p4.v-n4.v; p5.v-n5.v; p6.v-n6.v; p7.v-n7.v; p8.v-n8.v; p9.v-n9.v; p10.v-n10.v; p11.v-n11.v; p12.v-n12.v; p13.v-n13.v; p14.v-n14.v; p15.v-n15.v; p16.v-n16.v ];
    v == R.*i + L*i.der;
end

end
